# ─────────────────────────────────────────────────
#  Resume Intelligence Engine — Environment Config
# ─────────────────────────────────────────────────

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Recommended model for parallel resume + cover-letter generation.
# Confirm availability in your OpenRouter account before the first paid call.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# DeepSeek routing policy: choose a high-throughput endpoint under the current
# balanced price ceiling, then allow OpenRouter to fall back if needed.
OPENROUTER_PROVIDER_SORT=throughput
OPENROUTER_PROVIDER_ALLOW_FALLBACKS=true
OPENROUTER_PROVIDER_MAX_PROMPT_PRICE=0.10
OPENROUTER_PROVIDER_MAX_COMPLETION_PRICE=0.60

# Resume drafting does not need extended reasoning; disabling it reduces
# latency and avoids spending output tokens on hidden chain-of-thought.
OPENROUTER_REASONING_EFFORT=none

# Optional; the default is OpenRouter's public API endpoint.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional attribution headers.
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_APP_TITLE=Resume Intelligence Engine
