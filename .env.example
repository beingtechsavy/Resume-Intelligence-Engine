# ─────────────────────────────────────────────────
#  Resume Intelligence Engine — Environment Config
# ─────────────────────────────────────────────────
#
# Neutral RIE_* keys configure any OpenAI-compatible provider.
# The historical OPENROUTER_* keys are still honored as fallbacks,
# so this template works with an existing .env unchanged.

# API key (OpenRouter: https://openrouter.ai/keys)
RIE_API_KEY=your_openrouter_api_key_here

# Recommended model for the resume slot (strict LaTeX contract execution).
# Confirm availability in your provider account before the first paid call.
RIE_MODEL=deepseek/deepseek-v4.1-flash-1017

# Optional: run the cover-letter slot on a different model. The cover letter
# is prose (no LaTeX contract risk), so a strong-natural-writing model works
# well here — e.g. a writing-focused cheap tier. Unset = same model as above.
# RIE_CL_MODEL=openai/gpt-6-luna

# Provider flavour: openrouter | openai_compatible.
# Auto-detected from RIE_BASE_URL host when unset — endpoints on
# openrouter.ai get OpenRouter routing/reasoning/headers, everything
# else receives a plain request.
# RIE_PROVIDER=openrouter

# DeepSeek routing policy (OpenRouter only): choose a high-throughput
# endpoint under the current balanced price ceiling, then allow
# OpenRouter to fall back if needed.
RIE_PROVIDER_SORT=throughput
RIE_PROVIDER_ALLOW_FALLBACKS=true
RIE_PROVIDER_MAX_PROMPT_PRICE=0.10
RIE_PROVIDER_MAX_COMPLETION_PRICE=0.60

# Resume drafting does not need extended reasoning; disabling it reduces
# latency and avoids spending output tokens on hidden chain-of-thought.
RIE_REASONING_EFFORT=none

# Optional; the default is OpenRouter's public API endpoint.
# Point this at another provider and the OpenRouter-specific request
# extras are dropped automatically.
# RIE_BASE_URL=https://openrouter.ai/api/v1

# Optional candidate identity fallbacks (normally taken from
# personal_info in data_pool.json).
# RIE_OWNER_NAME=Your Name

# Optional attribution headers (OpenRouter only).
# RIE_HTTP_REFERER=https://your-site.example
# RIE_APP_TITLE=Resume Intelligence Engine
