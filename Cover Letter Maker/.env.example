# Your DeepSeek API key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Model to use.
#   deepseek-v4-pro   → DeepSeek-V4 Pro with thinking mode (recommended)
#   deepseek-v4-flash → Faster, cheaper variant
DEEPSEEK_MODEL=deepseek-v4-pro
